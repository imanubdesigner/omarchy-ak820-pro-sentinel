[Unit]
Description=AK820 Pro Sentinel - read only watchdog for the Ajazz AK820 Pro 2.4 GHz receiver
After=systemd-udevd.service
Wants=systemd-udevd.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/local/bin/ak820-pro-sentinel
SyslogIdentifier=ak820-pro-sentinel
Restart=on-failure
RestartSec=3
RuntimeDirectory=ak820-pro-sentinel
RuntimeDirectoryMode=0755
StateDirectory=ak820-pro-sentinel
User=root
Group=root
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
